{
  "name": "neev-identity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:domain && npm run build && node --test tests/rendered-html.test.mjs",
    "test:domain": "node --experimental-strip-types --test tests/domain.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "deploy:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1",
    "build:netlify": "next build",
    "dev:netlify": "netlify dev",
    "deploy:netlify": "netlify deploy --build --prod"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "@langchain/langgraph": "^1.4.8",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^10.7.9",
    "@netlify/database": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "india-state-district": "^1.0.5",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "netlify-cli": "^26.2.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Neev Identity Reconstruction"
}
