# Add two or three comma-separated keys. The server rotates to the next key on quota/auth errors.
GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.5-flash

# Optional fallback provider. Keep keys server-side; never prefix them with NEXT_PUBLIC_.
GROQ_API_KEYS=key_one,key_two,key_three
GROQ_MODEL=qwen/qwen3.6-27b
